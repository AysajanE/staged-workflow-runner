{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Acceptance-Aware Revision Directive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "directive_id", "created_at", "supervisor_session_id",
    "source_review_cycle_id", "source_subject_id", "source_subject_sha256",
    "consolidation_path", "consolidation_sha256", "accepted_recommendations",
    "rejected_recommendations", "mandatory_blockers", "revised_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.revision_directive.v1"},
    "directive_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "source_review_cycle_id": {"type": "string", "minLength": 1},
    "source_subject_id": {"$ref": "#/$defs/sha256"},
    "source_subject_sha256": {"$ref": "#/$defs/sha256"},
    "consolidation_path": {"type": "string", "minLength": 1},
    "consolidation_sha256": {"$ref": "#/$defs/sha256"},
    "accepted_recommendations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accepted"}},
    "rejected_recommendations": {"type": "array", "items": {"$ref": "#/$defs/rejected"}},
    "mandatory_blockers": {"type": "array", "items": {"type": "object"}},
    "revised_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "revision_scaffold_path": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseRecommendation": {
      "type": "object",
      "required": ["recommendation_id", "source_agent", "recommendation", "evidence", "affected_artifacts"],
      "properties": {
        "recommendation_id": {"type": "string", "minLength": 1},
        "source_agent": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "affected_artifacts": {"type": "array"}
      }
    },
    "accepted": {"$ref": "#/$defs/baseRecommendation"},
    "rejected": {
      "allOf": [
        {"$ref": "#/$defs/baseRecommendation"},
        {"type": "object", "required": ["rejection_rationale"], "properties": {"rejection_rationale": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
