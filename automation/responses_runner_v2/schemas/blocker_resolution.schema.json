{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Blocker Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resolution_id",
    "created_at",
    "supervisor_session_id",
    "review_cycle_id",
    "blocker_id",
    "source_decision_path",
    "source_decision_sha256",
    "resolution",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.blocker_resolution.v1"},
    "resolution_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "blocker_id": {"type": "string", "minLength": 1},
    "source_decision_path": {"type": "string", "minLength": 1},
    "source_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resolution": {"enum": ["resolved", "accepted_risk", "superseded", "still_blocking"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
