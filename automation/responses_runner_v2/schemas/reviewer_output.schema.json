{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Reviewer Model Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "approval_decision",
    "summary",
    "reviewed_artifacts",
    "missing_artifacts",
    "blocking_issues",
    "non_blocking_improvements",
    "recommendations",
    "unsupported_claims",
    "evidence",
    "validation_errors",
    "next_action"
  ],
  "properties": {
    "status": {"const": "succeeded"},
    "approval_decision": {
      "enum": ["approve", "approve_with_conditions", "do_not_approve", "blocked"]
    },
    "summary": {"type": "string", "minLength": 1},
    "reviewed_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "missing_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/missingArtifact"}
    },
    "blocking_issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "non_blocking_improvements": {
      "type": "array",
      "items": {"$ref": "#/$defs/improvement"}
    },
    "recommendations": {
      "type": "array",
      "items": {"$ref": "#/$defs/recommendation"}
    },
    "unsupported_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/unsupportedClaim"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "validation_errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_action": {
      "enum": [
        "proceed_to_consolidation",
        "proceed_to_operator_acceptance",
        "create_review_bundle",
        "create_final_bundle",
        "rerun_after_archive",
        "human_pause",
        "blocked"
      ]
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "bytes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "missingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "severity", "description", "evidence", "affected_artifacts"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "blocking", "high", "medium", "low"]},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "affected_artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "description", "evidence", "affected_artifacts"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "affected_artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "source", "quote_or_summary"],
      "properties": {
        "artifact_path": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "source": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "quote_or_summary": {"type": "string", "minLength": 1}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "summary", "evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_id",
        "severity",
        "recommendation",
        "evidence",
        "affected_artifacts",
        "exact_change_needed",
        "rationale_for_no_change",
        "operator_decision",
        "decision_rationale",
        "rejected_reason",
        "changes_applied",
        "validation_evidence",
        "consolidation_recommendation"
      ],
      "properties": {
        "recommendation_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "blocking", "high", "medium", "low"]},
        "recommendation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "affected_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exact_change_needed": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "rationale_for_no_change": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "operator_decision": {
          "anyOf": [
            {"enum": ["accepted", "rejected", "deferred", "already_satisfied", "out_of_scope"]},
            {"type": "null"}
          ]
        },
        "decision_rationale": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "rejected_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "changes_applied": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "validation_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "consolidation_recommendation": {
          "anyOf": [
            {"enum": ["accepted_for_operator_review", "rejected", "needs_operator_judgment", "duplicate", "already_satisfied", "out_of_scope"]},
            {"type": "null"}
          ]
        }
      }
    },
    "unsupportedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source", "reason"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
