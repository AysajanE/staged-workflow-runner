{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Stage Checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "stage_id", "stage_number", "attempt_dir",
    "updated_at", "status", "local_state", "remote_status", "terminal",
    "resume_mode", "request_payload_path", "input_manifest_json_path",
    "input_manifest_markdown_path", "token_preflight", "artifacts", "finalization"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.stage_checkpoint.v2"},
    "run_id": {"$ref": "#/$defs/id"},
    "stage_id": {"$ref": "#/$defs/id"},
    "stage_number": {"type": "integer", "minimum": 1},
    "attempt_id": {"type": "string", "pattern": "^attempt_[0-9]{3,}$"},
    "attempt_dir": {"$ref": "#/$defs/path"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"$ref": "#/$defs/localState"},
    "local_state": {"$ref": "#/$defs/localState"},
    "remote_status": {"type": ["string", "null"]},
    "terminal": {"type": "boolean"},
    "resume_mode": {"enum": ["fresh_submit", "resume_response_id", "refresh_status_only"]},
    "review_checkpoint_required": {"type": "boolean"},
    "review_bundle_path": {"$ref": "#/$defs/path"},
    "request_payload_path": {"$ref": "#/$defs/path"},
    "input_manifest_json_path": {"$ref": "#/$defs/path"},
    "input_manifest_markdown_path": {"$ref": "#/$defs/path"},
    "token_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "pending", "previously_completed", "succeeded", "skipped_by_operator",
            "continued_after_retryable_service_failure", "failed_closed"
          ]
        },
        "attempts": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "error_message": {"type": ["string", "null"]},
        "diagnostics_path": {"type": ["string", "null"]}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "model", "background", "store"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string"},
        "model": {"type": "string"},
        "background": {"type": "boolean"},
        "store": {"type": "boolean"},
        "created_at": {"type": "integer", "minimum": 0},
        "completed_at": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_dir", "response_latest_json_path"],
      "properties": {
        "stage_dir": {"$ref": "#/$defs/path"},
        "response_latest_json_path": {"$ref": "#/$defs/path"},
        "response_final_json_path": {"$ref": "#/$defs/path"},
        "response_final_markdown_path": {"$ref": "#/$defs/path"},
        "artifact_markdown_path": {"$ref": "#/$defs/path"},
        "artifact_markdown_sha256": {"$ref": "#/$defs/hash"},
        "structured_output_path": {"$ref": "#/$defs/path"},
        "sidecar_response_json_path": {"$ref": "#/$defs/path"},
        "sidecar_response_markdown_path": {"$ref": "#/$defs/path"},
        "uploads_json_path": {"$ref": "#/$defs/path"}
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"enum": ["pending", "completed"]}}
    },
    "error": {},
    "incomplete_details": {}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "path": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "localState": {
      "enum": [
        "prepared", "staging_inputs", "uploading", "preflight_passed", "submitting",
        "submission_outcome_unknown", "submitted", "in_progress",
        "remote_terminal_pending_finalization", "finalized", "waiting_for_review",
        "completed", "failed", "failed_complete", "failed_no_artifact", "cancelled",
        "cancelling", "incomplete", "blocked", "blocked_preflight", "revision_requested"
      ]
    }
  }
}
