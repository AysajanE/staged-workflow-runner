{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Frozen Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "workflow_id",
    "assurance_profile",
    "data_handling_policy",
    "workflow_asset_set_hash",
    "effective_runtime",
    "effective_runtime_sha256",
    "members",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.run_contract.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "workflow_id": {"type": "string", "minLength": 1},
    "assurance_profile": {"enum": ["critical", "reviewed", "standard", "fast"]},
    "data_handling_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity", "allowed_evidence_kinds", "local_directory_mode", "local_file_mode",
        "retain_raw_request", "retain_raw_response", "retain_reviewer_output",
        "retain_reasoning_summary", "api_store_allowed", "file_purpose",
        "delete_uploaded_files_on_complete"
      ],
      "properties": {
        "sensitivity": {"type": "string", "minLength": 1},
        "allowed_evidence_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "local_directory_mode": {"const": "0700"},
        "local_file_mode": {"const": "0600"},
        "retain_raw_request": {"type": "boolean"},
        "retain_raw_response": {"type": "boolean"},
        "retain_reviewer_output": {"type": "boolean"},
        "retain_reasoning_summary": {"type": "boolean"},
        "api_store_allowed": {"type": "boolean"},
        "file_purpose": {"type": "string", "minLength": 1},
        "delete_uploaded_files_on_complete": {"type": "boolean"}
      }
    },
    "workflow_asset_set_hash": {"$ref": "#/$defs/hash"},
    "effective_runtime": {"type": "object"},
    "effective_runtime_sha256": {"$ref": "#/$defs/hash"},
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "bytes"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/hash"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "contract_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
