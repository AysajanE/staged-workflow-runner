{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Final Delivery Bundle",
  "description": "Domain-neutral final bundle for high-stakes coding, business, research, and operational work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "created_at",
    "assurance_profile",
    "subject",
    "summary",
    "deliverables",
    "evidence",
    "validation_evidence",
    "reviews",
    "operator_acceptance",
    "open_items",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "responses_runner_v2.final_delivery_bundle.v1"
    },
    "delivery_id": {
      "$ref": "#/$defs/idString"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "assurance_profile": {
      "enum": [
        "critical",
        "reviewed",
        "standard",
        "fast"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "run_id",
        "terminal_stage_id",
        "terminal_attempt_id",
        "terminal_artifact_sha256"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/idString"
        },
        "run_id": {
          "$ref": "#/$defs/idString"
        },
        "terminal_stage_id": {
          "$ref": "#/$defs/idString"
        },
        "terminal_attempt_id": {
          "$ref": "#/$defs/idString"
        },
        "terminal_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/deliverable"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "validation_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationItem"
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewReference"
      }
    },
    "operator_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision",
        "artifact_path",
        "artifact_sha256"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/idString"
        },
        "decision": {
          "const": "approve"
        },
        "artifact_path": {
          "$ref": "#/$defs/pathString"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "idString": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "pathString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable_id",
        "kind",
        "path",
        "sha256",
        "description"
      ],
      "properties": {
        "deliverable_id": {
          "$ref": "#/$defs/idString"
        },
        "kind": {
          "enum": [
            "document",
            "dataset",
            "analysis",
            "decision_record",
            "implementation",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/pathString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "citation_type",
        "locator",
        "claim"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/idString"
        },
        "citation_type": {
          "enum": [
            "workspace_file",
            "attached_document",
            "operator_input",
            "stage_artifact",
            "url"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "method",
        "status",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/idString"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact_path",
        "artifact_sha256",
        "decision"
      ],
      "properties": {
        "role": {
          "enum": [
            "operator_codex",
            "codex_review_agent",
            "claude_review_agent",
            "consolidation"
          ]
        },
        "artifact_path": {
          "$ref": "#/$defs/pathString"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "enum": [
            "approve",
            "block",
            "advisory"
          ]
        }
      }
    }
  }
}
