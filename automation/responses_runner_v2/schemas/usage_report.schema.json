{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Usage Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempts", "by_lane", "totals"],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.usage_report.v1"},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id", "lane", "model", "status", "duration_ms", "request_wall_ms",
          "poll_wall_ms", "retry_count", "upload_count", "uploaded_files", "uploaded_bytes", "usage"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "lane": {"type": "string", "minLength": 1},
          "model": {"type": ["string", "null"], "minLength": 1},
          "status": {"type": ["string", "null"], "minLength": 1},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "request_wall_ms": {"type": ["integer", "null"], "minimum": 0},
          "poll_wall_ms": {"type": ["integer", "null"], "minimum": 0},
          "retry_count": {"type": ["integer", "null"], "minimum": 0},
          "upload_count": {"type": ["integer", "null"], "minimum": 0},
          "uploaded_files": {"type": ["integer", "null"], "minimum": 0},
          "uploaded_bytes": {"type": ["integer", "null"], "minimum": 0},
          "usage": {"$ref": "#/$defs/usage"}
        }
      }
    },
    "by_lane": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/totals"}
    },
    "totals": {"$ref": "#/$defs/totals"}
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "properties": {
        "schema_version": {"const": "responses_runner_v2.normalized_usage.v1"},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "properties": {
        "attempt_count": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
