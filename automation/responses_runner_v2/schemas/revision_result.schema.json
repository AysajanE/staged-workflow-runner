{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Operator Revision Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "created_at", "supervisor_session_id",
    "source_review_cycle_id", "source_subject_id", "directive_path", "directive_sha256",
    "revision_job_path", "revision_job_sha256", "operator_decision_path",
    "operator_decision_sha256", "revised_artifacts", "accepted_recommendation_ids",
    "rejected_recommendation_ids", "new_review_cycle_id", "revised_review_job_path",
    "revised_review_job_sha256"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.revision_result.v1"},
    "result_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "source_review_cycle_id": {"type": "string", "minLength": 1},
    "source_subject_id": {"$ref": "#/$defs/sha256"},
    "directive_path": {"type": "string", "minLength": 1},
    "directive_sha256": {"$ref": "#/$defs/sha256"},
    "revision_job_path": {"type": "string", "minLength": 1},
    "revision_job_sha256": {"$ref": "#/$defs/sha256"},
    "operator_decision_path": {"type": "string", "minLength": 1},
    "operator_decision_sha256": {"$ref": "#/$defs/sha256"},
    "revised_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "accepted_recommendation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rejected_recommendation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "new_review_cycle_id": {"type": "string", "minLength": 1},
    "revised_review_job_path": {"type": "string", "minLength": 1},
    "revised_review_job_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "before_sha256", "after_sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "before_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
