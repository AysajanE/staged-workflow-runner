{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Local Context Estimate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method",
    "instruction_bytes",
    "task_bytes",
    "manifest_bytes",
    "attachment_bytes",
    "estimated_input_tokens",
    "configured_input_limit",
    "requested_output_tokens",
    "safety_margin_tokens",
    "context_window",
    "within_input_limit",
    "within_context_window",
    "passed",
    "enforcement"
  ],
  "properties": {
    "schema_version": {
      "const": "responses_runner_v2.local_context_estimate.v1"
    },
    "method": {
      "const": "utf8_bytes_upper_bound_v1"
    },
    "instruction_bytes": {"type": "integer", "minimum": 0},
    "task_bytes": {"type": "integer", "minimum": 0},
    "manifest_bytes": {"type": "integer", "minimum": 0},
    "attachment_bytes": {"type": "integer", "minimum": 0},
    "estimated_input_tokens": {"type": "integer", "minimum": 0},
    "configured_input_limit": {
      "anyOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "requested_output_tokens": {"type": "integer", "minimum": 1},
    "safety_margin_tokens": {"type": "integer", "minimum": 0},
    "context_window": {
      "anyOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "within_input_limit": {"type": "boolean"},
    "within_context_window": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "enforcement": {
      "enum": [
        "advisory_exact_preflight_pending",
        "blocking_conservative_bound"
      ]
    }
  }
}
