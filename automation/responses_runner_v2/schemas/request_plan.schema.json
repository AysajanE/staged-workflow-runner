{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Request Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files", "duplicate_content_across_authorities", "estimate"],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.request_plan.v1"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbolic_file_id", "path", "sha256", "bytes", "authority"],
        "properties": {
          "symbolic_file_id": {"type": "string", "pattern": "^file_sha256_[0-9a-f]{64}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "duplicate_content_across_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "authorities"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authorities": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "sensitivity", "retain_raw_request", "retain_raw_response",
        "retain_reviewer_output", "retain_reasoning_summary", "request_store",
        "file_purpose", "delete_uploaded_files_on_complete"
      ],
      "properties": {
        "status": {"const": "passed"},
        "sensitivity": {"type": "string", "minLength": 1},
        "retain_raw_request": {"type": "boolean"},
        "retain_raw_response": {"type": "boolean"},
        "retain_reviewer_output": {"type": "boolean"},
        "retain_reasoning_summary": {"type": "boolean"},
        "request_store": {"type": "boolean"},
        "file_purpose": {"type": "string", "minLength": 1},
        "delete_uploaded_files_on_complete": {"type": "boolean"}
      }
    },
    "symbolic_request_payload": {"type": "object"},
    "normalized_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_bytes",
        "attachment_bytes",
        "model_facing_bytes",
        "estimated_input_tokens",
        "max_output_tokens",
        "safety_margin_tokens",
        "required_context_tokens",
        "context_window",
        "fits_context",
        "method"
      ],
      "properties": {
        "text_bytes": {"type": "integer", "minimum": 0},
        "attachment_bytes": {"type": "integer", "minimum": 0},
        "model_facing_bytes": {"type": "integer", "minimum": 0},
        "estimated_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0},
        "safety_margin_tokens": {"type": "integer", "minimum": 0},
        "required_context_tokens": {"type": "integer", "minimum": 0},
        "context_window": {"type": "integer", "minimum": 1},
        "fits_context": {"type": "boolean"},
        "method": {"const": "one_token_per_utf8_byte"}
      }
    }
  }
}
