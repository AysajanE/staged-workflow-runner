{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Stage State Transition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "stage_id", "attempt_id", "created_at",
    "base_manifest_revision", "target_manifest_revision", "base_manifest_sha256",
    "target_checkpoint_path", "target_checkpoint_sha256", "target_checkpoint",
    "target_run_manifest_sha256", "target_run_manifest"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.stage_state_transition.v1"},
    "run_id": {"$ref": "#/$defs/id"},
    "stage_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"type": "string", "pattern": "^attempt_[0-9]{3,}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "base_manifest_revision": {"type": "integer", "minimum": 1},
    "target_manifest_revision": {"type": "integer", "minimum": 2},
    "base_manifest_sha256": {"$ref": "#/$defs/hash"},
    "target_checkpoint_path": {"$ref": "#/$defs/path"},
    "target_checkpoint_sha256": {"$ref": "#/$defs/hash"},
    "target_checkpoint": {"type": "object"},
    "target_run_manifest_sha256": {"$ref": "#/$defs/hash"},
    "target_run_manifest": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "path": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
