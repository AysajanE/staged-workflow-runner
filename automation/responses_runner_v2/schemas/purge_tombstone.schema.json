{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Evidence Purge Tombstone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "purge_id", "created_at", "updated_at", "status",
    "target_dir", "categories", "reason", "records"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.purge_tombstone.v1"},
    "purge_id": {"type": "string", "pattern": "^purge_[a-zA-Z0-9_-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pending", "completed"]},
    "target_dir": {"type": "string", "minLength": 1},
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["raw_request", "raw_response", "reviewer_output", "reasoning_summary"]}
    },
    "reason": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "path", "sha256", "bytes", "status"],
        "properties": {
          "category": {"enum": ["raw_request", "raw_response", "reviewer_output", "reasoning_summary"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "status": {"enum": ["pending", "deleted"]},
          "deleted_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
