{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Supervisor Command Template",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "agent", "canonical_command", "cwd", "timeout_seconds"],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.supervisor_command_template.v2"},
    "agent": {
      "enum": ["operator_codex", "codex_review_agent", "claude_review_agent", "consolidation_pass"]
    },
    "canonical_command": {"type": "string", "minLength": 1},
    "argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primary_argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fallback_argv_template": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1}
  },
  "anyOf": [
    {"required": ["argv_template"]},
    {"required": ["primary_argv_template"]}
  ]
}
