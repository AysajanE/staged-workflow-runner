{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Shared Cycle Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "supervisor_session_id",
    "review_cycle_id",
    "review_kind",
    "frozen_job_path",
    "frozen_job_sha256",
    "frozen_job_bytes",
    "job",
    "reviewed_artifact_manifest_path",
    "reviewed_artifact_manifest_sha256",
    "reviewed_artifact_manifest_bytes",
    "reviewed_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.review_input.v2"},
    "created_at": {"type": "string", "format": "date-time"},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "review_kind": {"enum": ["scaffold", "stage_output", "final_packet", "recovery"]},
    "frozen_job_path": {"type": "string", "minLength": 1},
    "frozen_job_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_job_bytes": {"type": "integer", "minimum": 1},
    "job": {"type": "object"},
    "reviewed_artifact_manifest_path": {"type": "string", "minLength": 1},
    "reviewed_artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewed_artifact_manifest_bytes": {"type": "integer", "minimum": 1},
    "reviewed_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
