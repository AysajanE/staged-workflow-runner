{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Frozen Review Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "command_id",
    "supervisor_session_id",
    "review_cycle_id",
    "review_kind",
    "actor_role",
    "job_sha256",
    "job_bytes",
    "prompt_sha256",
    "prompt_bytes",
    "reviewed_artifacts",
    "job"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.review_input.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "command_id": {"type": "string", "minLength": 1},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "review_kind": {
      "enum": ["scaffold", "stage_output", "final_packet", "recovery", "operator_acceptance", "consolidation"]
    },
    "actor_role": {"enum": ["operator_codex", "codex_review_agent", "claude_review_agent"]},
    "job_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "job_bytes": {"type": "integer", "minimum": 0},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_bytes": {"type": "integer", "minimum": 0},
    "reviewed_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "job": {"type": "object"}
  }
}
