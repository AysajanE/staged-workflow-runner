{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responses Runner V2 Hash-Bound Blocker Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "resolution_id", "created_at", "supervisor_session_id",
    "review_cycle_id", "subject_id", "subject_sha256", "blocker_id",
    "source_decision_path", "source_decision_sha256", "resolution", "affected_artifacts",
    "applied_changes", "accepted_risk_rationale", "validation_evidence",
    "operator_rationale", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "responses_runner_v2.blocker_resolution.v2"},
    "resolution_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "supervisor_session_id": {"type": "string", "minLength": 1},
    "review_cycle_id": {"type": "string", "minLength": 1},
    "subject_id": {"$ref": "#/$defs/sha256"},
    "subject_sha256": {"$ref": "#/$defs/sha256"},
    "blocker_id": {"type": "string", "minLength": 1},
    "source_decision_path": {"type": "string", "minLength": 1},
    "source_decision_sha256": {"$ref": "#/$defs/sha256"},
    "resolution": {"enum": ["resolved", "accepted_risk", "superseded", "still_blocking"]},
    "affected_artifacts": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}
    },
    "applied_changes": {
      "type": "array", "items": {"$ref": "#/$defs/change"}
    },
    "accepted_risk_rationale": {
      "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "validation_evidence": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}
    },
    "operator_rationale": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "before_sha256", "after_sha256", "summary"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "before_sha256": {"$ref": "#/$defs/nullableSha256"},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false, "required": ["method", "result"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "artifact_path": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "artifact_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    }
  }
}
