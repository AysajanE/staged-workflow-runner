{
  "schema_version": "responses_runner_v2.workflow_manifest.v2",
  "workflow_id": "synthetic_one_pass",
  "workflow_name": "Synthetic One Pass",
  "workflow_mode": "one_pass",
  "description": "Bounded one-pass validation workflow.",
  "assurance_profile": "critical",
  "shared_instructions_file": "../shared_instructions.md",
  "operator_requirements": {
    "minimum_primary_job_inputs": 0,
    "allow_reference_context": true
  },
  "defaults": {
    "model_roles": {
      "primary_generation": {
        "model": "gpt-5.6",
        "reasoning_effort": "xhigh",
        "reasoning_mode": "pro",
        "verbosity": "high",
        "prompt_cache_mode": "implicit",
        "prompt_cache_ttl": "30m"
      },
      "structural_processing": {
        "model": "gpt-5.6",
        "reasoning_effort": "high",
        "reasoning_mode": "standard",
        "verbosity": "medium",
        "prompt_cache_mode": "implicit",
        "prompt_cache_ttl": "30m"
      }
    },
    "request": {
      "background": true,
      "store": true,
      "parallel_tool_calls": true,
      "max_tool_calls": 8,
      "temperature": 1,
      "service_tier": "default",
      "token_preflight": {
        "enabled": true,
        "max_retries": 2,
        "retryable_http_status_codes": [
          429,
          500,
          502,
          503,
          504
        ],
        "on_retryable_service_failure": "fail_closed"
      },
      "file_uploads": {
        "purpose": "user_data",
        "delete_on_completion": false,
        "expires_after_seconds": 604800
      }
    }
  },
  "stages": [
    {
      "stage_id": "draft_summary",
      "stage_number": 1,
      "title": "Draft synthetic summary",
      "task_file": "../prompts/one_pass_task.md",
      "input_manifest_file": "../inputs/one_pass.input_manifest.json",
      "tool_profile_file": "../tools/no_tools.profile.json",
      "model_role": "primary_generation",
      "max_input_tokens": 700000,
      "max_output_tokens": 4000,
      "gate": "terminal",
      "output": {
        "primary_format": "text"
      }
    }
  ]
}
